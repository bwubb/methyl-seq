process {
    executor='slurm'
    queue='genoa-std-mem'
    errorStrategy='ignore'

    withName: 'FASTQC.*' {
        cpus=4
        memory='22528 MB'
        time='2h'
    }

    withName: 'MULTIQC.*' {
        cpus=2
        memory='11264 MB'
        time='1h'
    }

    withName: TRIMGALORE {
        cpus=4
        memory='22528 MB'
        time='4h'
    }

    withName: BISCUIT_INDEX {
        cpus=8
        memory='45056 MB'
        time='4h'
    }

    withName: BISCUIT_ALIGN {
        cpus=48
        memory='270336 MB'
        time='48h'
    }

    withName: ALIGNMENT_QC {
        cpus=4
        memory='22528 MB'
        time='8h'
    }

    withName: METHYLDACKEL {
        cpus=8
        memory='45056 MB'
        time='24h'
    }
}
