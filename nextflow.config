params {
    input='samples.tsv'
    outdir='results'
    library_prep='nebnext_emseq'
    library_preps='conf/library_preps.yml'
    adapter_r1=null
    adapter_r2=null
    trim_quality=null
    trim_length=null
    fasta='resources/Homo_sapiens.GRCh38.dna.primary_assembly.pUC19.Lambda.fa'
    aligner=null
    directional=null
    methyl_end_clip=10
    methyldackel_min_depth=1
    spikein_contigs='pUC19,LAMBDA'
    biscuit_container='docker://quay.io/biocontainers/biscuit:1.9.0.20260624--hdf5d79d_0'
    dupsifter_container='docker://quay.io/biocontainers/dupsifter:1.3.0.20241113--h566b1c6_1'
    samtools_container='docker://quay.io/biocontainers/samtools:1.21--h50ea8bc_0'
    methyldackel_container='docker://quay.io/biocontainers/methyldackel:0.6.1--h577a1d6_9'
}

process {
    errorStrategy='terminate'
}

timeline {
    enabled=true
    overwrite=true
    file="${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled=true
    overwrite=true
    file="${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled=true
    overwrite=true
    file="${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled=true
    overwrite=true
    file="${params.outdir}/pipeline_info/dag.html"
}

profiles {
    betty {
        includeConfig 'conf/betty.config'
    }

    lpc {
        includeConfig 'conf/lpc.config'
    }
}
